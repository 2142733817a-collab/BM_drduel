<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AdimiDuelTeamNames</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GameRoot Condition="'$(GameRoot)' == ''">F:\steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
    <ClientBin>$(GameRoot)\bin\Win64_Shipping_Client</ClientBin>
    <MultiplayerBin>$(GameRoot)\Modules\Multiplayer\bin\Win64_Shipping_Client</MultiplayerBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ClientBin)\TaleWorlds.Core.dll;$(ClientBin)\TaleWorlds.Engine.dll;$(ClientBin)\TaleWorlds.Engine.GauntletUI.dll;$(ClientBin)\TaleWorlds.GauntletUI.dll;$(ClientBin)\TaleWorlds.Library.dll;$(ClientBin)\TaleWorlds.MountAndBlade.dll;$(ClientBin)\TaleWorlds.ScreenSystem.dll;$(ClientBin)\TaleWorlds.TwoDimension.dll;$(ClientBin)\TaleWorlds.InputSystem.dll;$(ClientBin)\TaleWorlds.DotNet.dll" Private="false" />
    <Reference Include="$(MultiplayerBin)\TaleWorlds.MountAndBlade.Multiplayer.ViewModelCollection.dll" Private="false" />
    <Reference Include="$(ClientBin)\TaleWorlds.GauntletUI.Data.dll" Private="false" />
    <Reference Include="$(GameRoot)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll" Private="false" />
  </ItemGroup>
</Project>
